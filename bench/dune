 (name bench_irmin4_main)
 (libraries irmin irmin-lavyek eio_main unix repr ppx_repr)
 (preprocess (pps ppx_repr))
 (modules bench_common bench_irmin4 bench_irmin4_lavyek
  trace_replay bench_irmin4_main))

